FROM debian:stable-slim

ARG RCLONE_VERSION=1.76.0

RUN apt-get update && \
    apt-get install -y curl ca-certificates bash xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSLo /tmp/rclone.deb "https://downloads.rclone.org/v${RCLONE_VERSION}/rclone-v${RCLONE_VERSION}-linux-$(dpkg --print-architecture).deb" && \
    dpkg -i /tmp/rclone.deb && rm /tmp/rclone.deb && \
    # aptabase-clickhouse task
    curl https://clickhouse.com/ | sh && mv ./clickhouse /usr/local/bin/clickhouse

COPY entrypoint.sh /usr/local/bin/entrypoint.sh

# aptabase-clickhouse task
COPY tasks/aptabase-clickhouse.sh /usr/local/bin/tasks/aptabase-clickhouse.sh

RUN chmod +x /usr/local/bin/entrypoint.sh \
    /usr/local/bin/tasks/aptabase-clickhouse.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
